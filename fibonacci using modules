import fibonacci_module

# Read input
n = int(input())

# Validate input
if n > 0:
    fibonacci_sequence = fibonacci_module.generate_fibonacci_sequence(n)

    # Display sequence
    print(*fibonacci_sequence)
else:
    print("Please enter a positive integer")

#Fibbonaci.py
def generate_fibonacci_sequence(max_value):
    sequence = []
    a, b = 0, 1

    while a <= max_value:
        sequence.append(a)
        a, b = b, a + b

    return sequence
